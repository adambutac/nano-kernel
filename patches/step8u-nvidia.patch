+/*
+ * MALU-420 guard, per chip: the core and GPU nominals that R32 (4.9) computes
+ * for each Nano we run, keyed by the fuse values they are derived from. 5.10
+ * uses R32's core/GPU tables and selection code unchanged, so a mismatch
+ * means something else changed; a chip not listed here is refused as well.
+ *  - node8: R32 measured (r32-dvfs-table.txt): core 1125, gpu 1058.
+ *  - node7: on paper (dvfs/diagnosis.md): core 1075 = get_core_sku_max_mv()
+ *    for SoC process 1; gpu 1048 = GPU CVB at 921.6 MHz, -25 C range, for
+ *    GPU speedo value 2117.
+ */
+struct malu420_r32_nominal {
+	int soc_speedo_id;
+	int soc_process_id;
+	int gpu_speedo_id;
+	int gpu_speedo_value;
+	int core_mv;
+	int gpu_mv;
+};
+
+static const struct malu420_r32_nominal malu420_r32_nominals[] = {
+	{ 0, 0, 2, 2060, 1125, 1058 },	/* node8 */
+	{ 0, 1, 2, 2117, 1075, 1048 },	/* node7 */
+};
+
+static bool malu420_nominals_match_r32(void)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(malu420_r32_nominals); i++) {
+		const struct malu420_r32_nominal *n = &malu420_r32_nominals[i];
+
+		if (n->soc_speedo_id != tegra_sku_info.soc_speedo_id ||
+		    n->soc_process_id != tegra_sku_info.soc_process_id ||
+		    n->gpu_speedo_id != tegra_sku_info.gpu_speedo_id ||
+		    n->gpu_speedo_value != tegra_sku_info.gpu_speedo_value)
+			continue;
+
+		return vdd_core_rail.nominal_millivolts == n->core_mv &&
+		       vdd_gpu_rail.nominal_millivolts == n->gpu_mv;
+	}
+	return false;
+}
