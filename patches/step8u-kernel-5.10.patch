+ * this driver's nominal table: the highest rate whose min_volt fits under
+ * the given core voltage. NVIDIA's 5.10 DVFS stubbed this out ("FIXME EMC
+ * part is not enabled yet on K5.9") and capped EMC at a placeholder 1.2 GHz.
+ */
+static struct tegra210_emc *tegra210_emc_for_dvfs;
+
+bool tegra210_emc_is_ready(void)
+{
+	return READ_ONCE(tegra210_emc_for_dvfs) != NULL;
+}
+EXPORT_SYMBOL(tegra210_emc_is_ready);
+
+unsigned long tegra210_predict_emc_rate(int millivolts)
+{
+	struct tegra210_emc *emc = READ_ONCE(tegra210_emc_for_dvfs);
+	unsigned long rate = 0;
+	unsigned int i;
+
+	if (!emc || !emc->nominal || !emc->num_timings)
+		return -EINVAL;
+
+	for (i = 0; i < emc->num_timings; i++) {
+		if (emc->nominal[i].min_volt > millivolts)
+			break;
+		rate = emc->nominal[i].rate * 1000UL;
+	}
+
+	return rate;
+}
