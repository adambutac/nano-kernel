 /*
+ * MALU-420: on 5.10 T210 the MC belongs to mainline's tegra-mc driver, so
+ * NVIDIA's tegra_mc_flush*() return early (no NVIDIA MC device). Also drive
+ * mainline's MC hot reset for the GPU client ("mc" reset in DT), or the GPU
+ * stays in the hot reset 4.9 left it in and can't reach memory.
+ */
+static struct reset_control *gm20b_mc_reset(struct device *dev)
+{
+	static struct reset_control *rst;
+
+	if (!rst) {
+		rst = reset_control_get_exclusive(dev, "mc");
+		if (IS_ERR(rst)) {
+			dev_err(dev, "MALU-420: no mc reset: %ld\n", PTR_ERR(rst));
+			rst = NULL;
+		}
+	}
+	return rst;
+}
+
+static void gm20b_mc_flush(struct device *dev)
+{
+	struct reset_control *rst = gm20b_mc_reset(dev);
+
+	tegra_mc_flush(MC_CLIENT_GPU);
+	if (rst)
+		reset_control_assert(rst);
+}
+
+static void gm20b_mc_flush_done(struct device *dev)
+{
+	struct reset_control *rst = gm20b_mc_reset(dev);
+
+	tegra_mc_flush_done(MC_CLIENT_GPU);
+	if (rst)
+		reset_control_deassert(rst);
+}
