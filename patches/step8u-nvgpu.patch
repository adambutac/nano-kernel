+/*
+ * MALU-420: R32 (JetPack 4.6) userspace ABI. R32's struct nvgpu_alloc_as_args
+ * is 16 bytes with no VA ranges; the kernel then laid the address space out
+ * itself. Rebuild R32's layout (common/as.c + vm.c in R32 nvgpu): big pages
+ * on, low hole = big_page_size << 10, user VA up to 2^37 - 2^32 (kernel VA
+ * on top), small/big split at nvgpu_gmmu_va_small_page_limit().
+ */
+struct nvgpu_alloc_as_args_r32 {
+	__u32 big_page_size;
+	__s32 as_fd;
+	__u32 flags;
+	__u32 reserved;
+};
+#define NVGPU_GPU_IOCTL_ALLOC_AS_R32 \
+	_IOWR(NVGPU_GPU_IOCTL_MAGIC, 8, struct nvgpu_alloc_as_args_r32)
+
+static int gk20a_ctrl_alloc_as_r32(struct gk20a *g,
+		struct nvgpu_alloc_as_args_r32 *old)
+{
+	struct nvgpu_alloc_as_args args;
+	u32 big = old->big_page_size;
+	int err;
+
+	if (big == 0U)
+		big = g->ops.mm.gmmu.get_default_big_page_size();
+
+	(void) memset(&args, 0, sizeof(args));
+	args.big_page_size = big;
+	args.flags = old->flags;
+	args.va_range_start = (u64)big << 10;
+	args.va_range_end = BIT64(37) - BIT64(32);
+	if (!nvgpu_is_enabled(g, NVGPU_MM_UNIFY_ADDRESS_SPACES) &&
+	    (old->flags & NVGPU_GPU_IOCTL_ALLOC_AS_FLAGS_UNIFIED_VA) == 0U)
+		args.va_range_split = nvgpu_gmmu_va_small_page_limit();
+
+	err = gk20a_ctrl_alloc_as(g, &args);
+	if (err == 0)
+		old->as_fd = args.as_fd;
+	nvgpu_log_info(g, "MALU-420 R32 alloc_as: big %u flags 0x%x -> %d",
+		       big, old->flags, err);
+	return err;
+}
