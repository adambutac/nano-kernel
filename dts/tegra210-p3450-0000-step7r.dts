		#address-cells = <0x01>;
		#size-cells = <0x00>;
		clocks = <0x03 0xd3>;
		clock-names = "qspi";
		resets = <0x03 0xd3>;
		reset-names = "qspi";
		dmas = <0x24 0x05 0x24 0x05>;
		dma-names = "rx\0tx";
		status = "disabled";
	};

	usb@7d000000 {
		compatible = "nvidia,tegra210-ehci\0nvidia,tegra30-ehci\0usb-ehci";
		reg = <0x00 0x7d000000 0x00 0x4000>;
		interrupts = <0x00 0x14 0x04>;
		phy_type = "utmi";
		clocks = <0x03 0x16>;
		clock-names = "usb";
		resets = <0x03 0x16>;
		reset-names = "usb";
		nvidia,phy = <0x46>;
		status = "disabled";
	};

	usb-phy@7d000000 {
		compatible = "nvidia,tegra210-usb-phy\0nvidia,tegra30-usb-phy";
		reg = <0x00 0x7d000000 0x00 0x4000 0x00 0x7d000000 0x00 0x4000>;
		phy_type = "utmi";
