	dvfs {
		compatible = "nvidia,tegra210-dvfs";
		vdd-core-supply = <0x64>;
		vdd-gpu-supply = <0x23>;
		nvidia,gpu-max-freq-khz = <0xe1000>;
		nvidia,cpu-rail-unmanaged;
	};

	vdd-gpu-scaling-cdev {
		compatible = "nvidia,tegra210-rail-scaling-cdev";
		cooling-min-state = <0x00>;
		cooling-max-state = <0x05>;
		#cooling-cells = <0x02>;
		cdev-type = "gpu_scaling";
		nvidia,constraint;
		nvidia,trips = <0x201 0x3b6 0x202 0x00 0x203 0x00 0x204 0x00 0x205 0x00 0x206 0x00>;
		phandle = <0x235>;
	};

	tegra-carveouts {
		compatible = "nvidia,carveouts";
		status = "okay";
	};

	host1x {
		compatible = "nvidia,tegra210-host1x\0simple-bus";
		reg = <0x00 0x50000000 0x00 0x34000>;
		interrupts = <0x00 0x41 0x04 0x00 0x43 0x04>;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		clocks = <0x03 0x1c 0x03 0x77>;
		clock-names = "host1x\0actmon";
		resets = <0x03 0x1c>;
		nvidia,ch-base = <0x00>;
		nvidia,nb-channels = <0x0c>;
		nvidia,nb-hw-pts = <0xc0>;
		nvidia,pts-base = <0x00>;
		nvidia,nb-pts = <0xc0>;
		status = "okay";
		phandle = <0x210>;

		i2c@546c0000 {
			compatible = "nvidia,tegra210-i2c-vi";
			reg = <0x00 0x546c0000 0x00 0x40000>;
			interrupts = <0x00 0x11 0x04>;
			clocks = <0x03 0xd0 0x03 0x51>;
			clock-names = "div-clk\0slow";
			resets = <0x03 0xd0>;
			reset-names = "i2c";
			power-domains = <0x0f>;
			status = "okay";
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			power-sensor@40 {
				compatible = "ti,ina3221";
				reg = <0x40>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				input@0 {
					reg = <0x00>;
					label = "POM_5V_IN";
					shunt-resistor-micro-ohms = <0x1388>;
				};

				input@1 {
					reg = <0x01>;
					label = "POM_5V_GPU";
					shunt-resistor-micro-ohms = <0x1388>;
				};

				input@2 {
					reg = <0x02>;
					label = "POM_5V_CPU";
					shunt-resistor-micro-ohms = <0x1388>;
				};
			};
		};
	};

	gpu {
		compatible = "nvidia,tegra210-gm20b\0nvidia,gm20b";
		nvidia,host1x = <0x210>;
		reg = <0x00 0x57000000 0x00 0x1000000 0x00 0x58000000 0x00 0x1000000 0x00 0x538f0000 0x00 0x1000>;
		interrupts = <0x00 0x9d 0x04 0x00 0x9e 0x04>;
		interrupt-names = "stall\0nonstall";
		resets = <0x03 0xb8 0x0d 0x16>;
		reset-names = "gpu\0mc";
		status = "okay";
		iommus = <0x0d 0x11>;
		#cooling-cells = <0x02>;
		phandle = <0x262>;
	};

	dfll-cdev-cap {
		compatible = "nvidia,tegra-dfll-cdev-action";
		act-dev = <0x48>;
		cdev-type = "DFLL-cap";
		#cooling-cells = <0x02>;
		phandle = <0x230>;
	};

	dfll-cdev-floor {
		compatible = "nvidia,tegra-dfll-cdev-action";
		act-dev = <0x48>;
		cdev-type = "DFLL-floor";
		#cooling-cells = <0x02>;
		phandle = <0x231>;
	};

	watchdog@60005100 {
		compatible = "nvidia,tegra-wdt-t21x";
		reg = <0x00 0x60005100 0x00 0x20 0x00 0x60005088 0x00 0x08>;
		interrupts = <0x00 0x7b 0x04>;
		nvidia,expiry-count = <0x04>;
		nvidia,timer-index = <0x07>;
		nvidia,heartbeat-init = <0x1e>;
		nvidia,enable-on-init;
		status = "okay";
	};

	actmon@6000c800 {
		compatible = "nvidia,tegra210-actmon\0nvidia,tegra124-actmon";
		reg = <0x00 0x6000c800 0x00 0x400>;
		interrupts = <0x00 0x2d 0x04>;
		clocks = <0x03 0x77 0x03 0x39>;
		clock-names = "actmon\0emc";
		resets = <0x03 0x77>;
		reset-names = "actmon";
		status = "okay";
	};

	tegra-aotag {
		compatible = "nvidia,tegra21x-aotag";
		parent-block = <0x25>;
		status = "okay";
		sensor-params-tall = <0x4c>;
		sensor-params-tiddq = <0x01>;
		sensor-params-ten-count = <0x10>;
		sensor-params-tsample = <0x09>;
		sensor-params-pdiv = <0x08>;
		sensor-params-tsamp-ate = <0x27>;
		sensor-params-pdiv-ate = <0x08>;
		#thermal-sensor-cells = <0x00>;
		sensor-name = "aotag0";
		sensor-id = <0x00>;
		advertised-sensor-id = <0x09>;
		sensor-nominal-temp-cp = <0x19>;
		sensor-nominal-temp-ft = <0x69>;
		sensor-compensation-a = <0x2988>;
		sensor-compensation-b = <0xfffef85e>;
		phandle = <0x250>;
	};

	core_dvfs_cdev_floor {
		compatible = "nvidia,tegra-core-cdev-action";
		cdev-type = "CORE-floor";
		#cooling-cells = <0x02>;
		phandle = <0x251>;
	};

	core_dvfs_cdev_cap {
		compatible = "nvidia,tegra-core-cdev-action";
		cdev-type = "CORE-cap";
		#cooling-cells = <0x02>;
		clocks = <0x03 0x198 0x03 0x1a1 0x03 0x1b8 0x03 0x1f6 0x03 0x206>;
		clock-names = "c2bus_cap\0c3bus_cap\0sclk_cap\0host1x_cap\0adsp_cap";
		phandle = <0x252>;
	};

	vdd-gpu-vmax-cdev {
		compatible = "nvidia,tegra210-rail-vmax-cdev";
		status = "okay";
		cooling-min-state = <0x00>;
		cooling-max-state = <0x01>;
		#cooling-cells = <0x02>;
		cdev-type = "GPU-cap";
		nvidia,constraint-ucm2;
		nvidia,trips = <0x25a 0x46c 0x442>;
		clocks = <0x03 0x1eb>;
		clock-names = "cap-clk";
		phandle = <0x253>;
	};

	cpu-throttle-alert {
		compatible = "userspace-therm-alert";
		cdev-type = "cpu-throttle-alert";
		#cooling-cells = <0x02>;
		phandle = <0x264>;
	};

	gpu-throttle-alert {
		compatible = "userspace-therm-alert";
		cdev-type = "gpu-throttle-alert";
		#cooling-cells = <0x02>;
		phandle = <0x265>;
	};

	hot-surface-alert {
		compatible = "userspace-therm-alert";
		cdev-type = "hot-surface-alert";
		#cooling-cells = <0x02>;
		phandle = <0x266>;
	};
};
