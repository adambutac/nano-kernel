	aliases {
		sdhci3 = "/mmc@700b0600";
		sdhci2 = "/mmc@700b0400";
		sdhci1 = "/mmc@700b0200";
		sdhci0 = "/mmc@700b0000";
		ethernet = "/pcie@1003000/pci@2,0/ethernet@0,0";
		rtc0 = "/i2c@7000d000/pmic@3c";
		rtc1 = "/rtc@7000e000";
		serial0 = "/serial@70006000";
	};

	chosen {
		stdout-path = "serial0:115200n8";
		nvidia,tegra-always-on-personality;
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x00 0x80000000 0x00 0x7ee00000 0x01 0x00 0x00 0x7f200000>;
	};

	clock@0 {
		compatible = "fixed-clock";
		clock-frequency = <0x8000>;
		#clock-cells = <0x00>;
		phandle = <0x2a>;
	};

	fan {
		compatible = "pwm-fan";
		pwms = <0x5b 0x03 0xb116>;
		cooling-levels = <0x00 0x40 0x80 0xff>;
		#cooling-cells = <0x02>;
		phandle = <0x52>;
	};

	gpio-keys {
		compatible = "gpio-keys";

		power {
			label = "Power";
			gpios = <0x22 0xbd 0x01>;
			linux,input-type = <0x01>;
			linux,code = <0x74>;
			debounce-interval = <0x1e>;
			wakeup-event-action = <0x01>;
			wakeup-source;
		};

		force-recovery {
			label = "Force Recovery";
			gpios = <0x22 0xbe 0x01>;
			linux,input-type = <0x01>;
			linux,code = <0x101>;
			debounce-interval = <0x1e>;
		};
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	regulator@0 {
		compatible = "regulator-fixed";
		regulator-name = "VDD_5V0_SYS";
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		regulator-always-on;
		regulator-boot-on;
		phandle = <0x29>;
	};

	regulator@1 {
		compatible = "regulator-fixed";
		regulator-name = "VDD_3V3_SYS";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		regulator-enable-ramp-delay = <0xf0>;
		regulator-disable-ramp-delay = <0x2c4c>;
		regulator-always-on;
		regulator-boot-on;
		gpio = <0x5c 0x03 0x00>;
		enable-active-high;
		vin-supply = <0x29>;
		phandle = <0x28>;
	};

	regulator@2 {
		compatible = "regulator-fixed";
		regulator-name = "VDD_3V3_SD";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		gpio = <0x22 0xcb 0x00>;
		enable-active-high;
		vin-supply = <0x28>;
		phandle = <0x39>;
	};

	regulator@3 {
		compatible = "regulator-fixed";
		regulator-name = "VDD_HDMI_5V0";
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		vin-supply = <0x29>;
		phandle = <0x20>;
	};

	regulator@4 {
		compatible = "regulator-fixed";
		regulator-name = "VDD_HUB_3V3";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		gpio = <0x22 0x06 0x00>;
		enable-active-high;
		vin-supply = <0x29>;
		phandle = <0x33>;
	};

	regulator@5 {
		compatible = "regulator-fixed";
		regulator-name = "VDD_CPU";
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		regulator-always-on;
		regulator-boot-on;
		gpio = <0x5c 0x05 0x00>;
		enable-active-high;
		vin-supply = <0x29>;
		phandle = <0x71>;
	};

	regulator@6 {
		compatible = "pwm-regulator";
		pwms = <0x5b 0x01 0x1f40>;
		regulator-name = "VDD_GPU";
		regulator-min-microvolt = <0xacda0>;
		regulator-max-microvolt = <0x143188>;
		regulator-ramp-delay = <0x50>;
		regulator-enable-ramp-delay = <0x7d0>;
		regulator-settling-time-us = <0xa0>;
		enable-gpios = <0x5c 0x06 0x00>;
		vin-supply = <0x29>;
		phandle = <0x23>;
	};

	regulator@7 {
		compatible = "regulator-fixed";
		regulator-name = "AVDD_IO_EDP_1V05";
		regulator-min-microvolt = <0x100590>;
		regulator-max-microvolt = <0x100590>;
		gpio = <0x5c 0x07 0x00>;
		enable-active-high;
		vin-supply = <0x5d>;
		phandle = <0x1a>;
	};

	regulator@8 {
		compatible = "regulator-fixed";
		regulator-name = "VDD_5V_USB";
		regulator-min-microvolt = <0x2faf080>;
		regulator-max-microvolt = <0x2faf080>;
		vin-supply = <0x29>;
		phandle = <0x32>;
	};

